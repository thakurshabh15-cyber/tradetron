# ═══════════════════════════════════════════════════════════════════════════
# TRADETHRONE PRODUCTION ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ── Core & Security ─────────────────────────────────────────────────────────
APP_NAME=TradeThrone
ENVIRONMENT=production
PORT=8080
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret
# Longer-lived access token for production UX (config comment recommends 1440).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Hosted Database (PostgreSQL - Neon, Supabase, Railway, Render) ──────────
# Both postgres:// and postgresql:// will be automatically normalized to postgresql+asyncpg://
DATABASE_URL=postgresql://tradetron_user:your_password@ep-sample-pooler.us-east-1.aws.neon.tech/tradetron?sslmode=require

# ── Redis Cache (REQUIRED in production) ────────────────────────────────────
# A managed TLS Redis endpoint (e.g. Upstash). Without it the app refuses to
# boot in production (no silent localhost fallback) and /readyz requires
# cache=true. UPSTASH_REDIS_URL takes precedence when both are set.
UPSTASH_REDIS_URL=rediss://replace_with_your_upstash_endpoint
# Legacy alternative: an explicit, non-localhost Redis endpoint.
REDIS_URL=

# ── Frontend & CORS ─────────────────────────────────────────────────────────
# URL of your deployed frontend (e.g. Vercel or Cloudflare Pages URL)
FRONTEND_URL=https://tradethrone.vercel.app
ALLOWED_ORIGINS=https://tradethrone.vercel.app,https://tradethrone.pages.dev,http://localhost:5173

# ── Broker Execution Modes ──────────────────────────────────────────────────
# "simulated" | "live"
BROKER_MODE=simulated

# Angel One Live Broker Credentials (optional if in simulated mode)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Zerodha Kite Live Broker Credentials (optional)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Binance Crypto Broker Credentials (optional)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Market Feed Modes ───────────────────────────────────────────────────────
# "demo" | "live"
FEED_MODE_EQUITY=demo
FEED_MODE_CRYPTO=demo
FEED_MODE_FOREX=demo

# ── OAuth Authentication ────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Razorpay Payment Gateway (Optional) ─────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email & SMS Dispatch (Optional for live OTP) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tradethrone.io
SMTP_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# ── Monitoring & Alerting (Optional) ────────────────────────────────────────
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Webhook hardening (MANDATORY in production) ─────────────────────────────
# Never enable WEBHOOK_LOCAL_MODE or SKIP_SIGNATURE_VERIFICATION in production —
# the app refuses to boot with either set. Provide real HMAC secrets instead.
TRADETHRONE_WEBHOOK_SECRET=replace_with_a_secure_random_secret_min_32_chars
UPSTOX_WEBHOOK_SECRET=
ANGELONE_WEBHOOK_SECRET=
BINANCE_WEBHOOK_SECRET=

# ── Logging ─────────────────────────────────────────────────────────────────
# Production emits single-line JSON logs (timestamp/level/logger/message).
LOG_LEVEL=INFO
