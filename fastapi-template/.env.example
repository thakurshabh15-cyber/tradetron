# ── Security ───────────────────────────────────────────────────
# REQUIRED: Generate a strong random secret for JWT signing
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
# Short-lived access token lifetime (minutes). Production: set 1440.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Broker Credentials (Angel One) ─────────────────────────────
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PASSWORD=your_password
ANGEL_TOTP_SECRET=your_totp_secret

# "simulated" = paper trading (no real orders)
# "live"      = connects to real broker APIs
BROKER_MODE=simulated

# ── Broker Credentials (Zerodha Kite Connect) ──────────────────
# Get from https://developers.kite.trade/
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ── Broker Credentials (Binance) ───────────────────────────────
# Get from https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── OAuth ──────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_ID=

# ── Email & SMS Dispatch (OTP & Notifications) ───────────────────
# SMTP (SendGrid, Mailgun, AWS SES, Gmail, custom SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tradethrone.io
SMTP_TLS=true

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 SMS (India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Registration verification policy (true = user must verify OTP before login)
REQUIRE_REGISTRATION_VERIFICATION=true

# ── Monitoring & Alerting ──────────────────────────────────────
# Sentry.io project DSN (free tier available)
SENTRY_DSN=
# Telegram Bot: create via @BotFather, chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Market Data Feed Modes ─────────────────────────────────────
# "demo" = simulated random prices with DEMO_SIMULATED label
# "live" = real exchange data (requires credentials for equity)
FEED_MODE_EQUITY=demo
FEED_MODE_CRYPTO=demo
FEED_MODE_FOREX=demo

# ── Application ────────────────────────────────────────────────
APP_NAME=TradeThrone
# "development" | "testing" | "production"  (defaults to development)
ENVIRONMENT=development
PORT=8080
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./trading.db
LOG_LEVEL=INFO

# CORS: comma-separated list or "*". Production locks to explicit origins.
ALLOWED_ORIGINS=*

# ── Bootstrap Admin (seeded on first boot) ─────────────────────
# Leave empty to generate a strong random password (printed once to logs).
ADMIN_DEFAULT_PASSWORD=

# ── Redis ────────────────────────────────────────────────────────
# Development defaults to the local redis://localhost:6379/0.
# PRODUCTION REQUIRES an explicit managed Redis — set UPSTASH_REDIS_URL
# (preferred, e.g. an Upstash rediss://… endpoint) or a non-localhost
# REDIS_URL. The app refuses to boot in production without one.
#
# On Render: create a Key Value instance (dashboard.render.com/new/redis)
# and link this service — Render auto-injects REDIS_URL, so no value needs
# to be pasted below.
UPSTASH_REDIS_URL=
REDIS_URL=redis://localhost:6379/0

# ── Webhook provider secrets ───────────────────────────────────────
TRADETHRONE_WEBHOOK_SECRET=
UPSTOX_WEBHOOK_SECRET=
ANGELONE_WEBHOOK_SECRET=
BINANCE_WEBHOOK_SECRET=
# Local-dev only: bypass HMAC signature verification and the Redis queue.
# MUST ALWAYS be false in production (the app refuses to boot otherwise).
WEBHOOK_LOCAL_MODE=false
WEBHOOK_HTTP_PORT=8001
SKIP_SIGNATURE_VERIFICATION=false

# ── Razorpay Payment Gateway (optional) ─────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend email API (optional) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAILS_FROM_EMAIL=otp@ecosystemofsamartinvesting.in

# ── OpenTelemetry (optional; metrics/tracing exporter) ─────────────
OTLP_ENDPOINT=
OTLP_INSECURE=true

# ── Risk Management ───────────────────────────────────────────
MAX_POSITION_SIZE=100
MAX_DAILY_LOSS=10000
MAX_ORDERS_PER_MINUTE=30

# ── Market Data Simulator ─────────────────────────────────────
SIM_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN
SIM_TICK_INTERVAL=1.0
