# ════════════════════════════════════════════════════════════════════
# TRADETHRONE — LIVE PRODUCTION ENVIRONMENT (.env.production)
# Deploy target: Render / Railway / Cloudflare (backend) + Vercel (frontend)
# Copy secrets from your vault — NEVER commit real values.
# ════════════════════════════════════════════════════════════════════

# ── Core & Security ────────────────────────────────────────────────
APP_NAME=TradeThrone
ENVIRONMENT=production
PORT=8080
JWT_SECRET=generate_via__python_-c_"import_secrets;print(secrets.token_hex(32))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database — Supabase PostgreSQL (Connection Pooler, Transaction Mode) ──
# Supabase Dashboard → Project Settings → Database → Connection Pooling
# Use the POOLER host (port 6543) for serverless/ASGI workloads.
DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ── Cache — Upstash Serverless Redis (TLS, rediss:// mandatory) ────
UPSTASH_REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<your-db>.upstash.io:6379

# ── Frontend & CORS (strict allow-list, credentials enabled) ───────
FRONTEND_URL=https://tradethrone.vercel.app
ALLOWED_ORIGINS=https://tradethrone.vercel.app,https://tradethron.vercel.app

# ── Webhook HMAC Security (STRICT in production) ───────────────────
SKIP_SIGNATURE_VERIFICATION=false
WEBHOOK_LOCAL_MODE=false
TRADETHRONE_WEBHOOK_SECRET=<hmac_secret_for_tradethrone_signal_webhooks>
ZERODHA_WEBHOOK_SECRET=
UPSTOX_WEBHOOK_SECRET=
ANGELONE_WEBHOOK_SECRET=
BINANCE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Indian Broker Execution Keys ───────────────────────────────────
BROKER_MODE=simulated   # flip to "live" only after SEBI KYC + broker activation

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_KEY=

# Dhan HQ
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Fyers v3
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Binance (execution)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ── Global Market Feed Keys ────────────────────────────────────────
FEED_MODE_EQUITY=demo    # "demo" | "live"
FEED_MODE_CRYPTO=demo
ALPACA_API_KEY=          # US equities / crypto alternative feed
ALPACA_SECRET_KEY=
OANDA_API_TOKEN=         # Forex streaming (EUR/USD, GBP/USD, USD/JPY)

# ── Payment Gateways (LIVE keys) ───────────────────────────────────
# Razorpay India (subscriptions + marketplace checkout)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (global cards / enterprise invoicing)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx

# ── Notifications (Transactional Email / SMS) ──────────────────────
RESEND_API_KEY=
EMAILS_FROM_EMAIL=otp@ecosystemofsamartinvesting.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tradethrone.io
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Observability ──────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
OTLP_ENDPOINT=

# ── Risk Management Guard-Rails (auto-pilot kill-switch) ───────────
MAX_POSITION_SIZE=100
MAX_DAILY_LOSS=10000
MAX_ORDERS_PER_MINUTE=30